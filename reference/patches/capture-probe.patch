+#include "saga2/annoy.h"
 
 namespace Saga2 {
 
@@ -254,6 +258,35 @@ void EventLoop(bool &running, bool) {
 void dumpGBASE(char *msg);
 
 void processEventLoop(bool updateScreen) {
+ if (ConfMan.getBool("native_probe")) {
+  static int frame = 0;
+  static bool active = false;
+  if (!active) {
+   active = true;
+   ++frame;
+   const char *phase = frame==1 ? "initial" : frame==180 ? "moved" : frame==190 ? "switched" : frame==220 ? "saved" : nullptr;
+   if (phase) {
+    TilePoint p = centerActorCoords();
+    warning("REFERENCE_PROBE %s frame=%d actor=%u u=%d v=%d z=%d rng=%u", phase, frame, getCenterActorID(), p.u,p.v,p.z,g_vm->_rnd->getSeed());
+   }
+   if (frame==1 || frame==190) {
+    Common::DumpFile out;
+    Common::Path filename = ConfMan.getPath("native_output").appendComponent(frame==1 ? "initial.ppm" : "controlled.ppm");
+    if (!out.open(filename)) error("Cannot open reference capture");
+    const char header[]="P6\n640 480\n255\n";
+    out.write(header, sizeof(header)-1);
+    byte palette[768];g_system->getPaletteManager()->grabPalette(palette,0,256);
+    const Graphics::Surface *screen=g_system->lockScreen();
+    for(int y=0;y<480;++y)for(int x=0;x<640;++x)out.write(palette+3*(*(const byte*)screen->getBasePtr(x,y)),3);
+    g_system->unlockScreen();out.close();
+   }
+   if(frame==20||frame==21||frame==100){Common::Event ev;ev.mouse.x=380;ev.mouse.y=330;ev.type=frame==20?Common::EVENT_MOUSEMOVE:frame==21?Common::EVENT_LBUTTONDOWN:Common::EVENT_LBUTTONUP;g_vm->_toolBase->handleMouse(ev,g_system->getMillis());}
+   if(frame==181){playSound(MKTAG('C','L','K',1));Common::Event ev;ev.type=Common::EVENT_KEYDOWN;ev.kbd.ascii='2';ev.kbd.keycode=Common::KEYCODE_2;g_vm->_toolBase->handleKeyStroke(ev);}
+   if(frame==220)g_vm->saveGameState(1,"Native round trip",false);
+   if(frame==260)endGame();
+   active=false;
+  }
+ }
 
 	debugC(1, kDebugEventLoop, "EventLoop: starting event loop");
 
